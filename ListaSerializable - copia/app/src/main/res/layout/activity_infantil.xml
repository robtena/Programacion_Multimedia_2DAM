<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainFicha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".InfantilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado superior -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0F2F1"
            android:padding="16dp"
            android:text="@string/titulo_infantil_header"
            android:textColor="#004D40"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ScrollView para scroll en pantallas pequeñas -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Contenedor vertical con margen interno de 24dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Etiqueta Campo Título -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Título:"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Valor Título (ID: txtTitulo) -->
                <TextView
                    android:id="@+id/txtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1D1B20"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Libro de aventuras" />

                <!-- Etiqueta Campo Autor -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Autor:"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Valor Autor (ID: txtAutor) -->
                <TextView
                    android:id="@+id/txtAutor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1D1B20"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Ana López" />

                <!-- Etiqueta Campo Edad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Edad recomendada:"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Valor Edad (ID: txtEdad) -->
                <TextView
                    android:id="@+id/txtEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1D1B20"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="10" />

                <!-- Botón Volver (ID: btnVolver) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolver"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="40dp"
                    android:backgroundTint="#2E6B4F"
                    android:text="@string/btn_volver"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="20dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>