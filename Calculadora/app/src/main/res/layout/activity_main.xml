<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="bottom"
    tools:context=".MainActivity">

    <!-- Pantalla de la calculadora -->
    <TextView
        android:id="@+id/txtVisor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:text="@string/visor_inicial"
        android:textSize="48sp"
        android:textStyle="bold" />

    <!-- Tabla con los botones -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <!-- Fila 1: 7, 8, 9, / -->
        <TableRow android:layout_marginVertical="4dp">
            <Button android:id="@+id/btn7" android:text="@string/btn_7" />
            <Button android:id="@+id/btn8" android:text="@string/btn_8" />
            <Button android:id="@+id/btn9" android:text="@string/btn_9" />
            <Button android:id="@+id/btnDividir" android:text="@string/btn_dividir" />
        </TableRow>

        <!-- Fila 2: 4, 5, 6, * -->
        <TableRow android:layout_marginVertical="4dp">
            <Button android:id="@+id/btn4" android:text="@string/btn_4" />
            <Button android:id="@+id/btn5" android:text="@string/btn_5" />
            <Button android:id="@+id/btn6" android:text="@string/btn_6" />
            <Button android:id="@+id/btnMultiplicar" android:text="@string/btn_multiplicar" />
        </TableRow>

        <!-- Fila 3: 1, 2, 3, - -->
        <TableRow android:layout_marginVertical="4dp">
            <Button android:id="@+id/btn1" android:text="@string/btn_1" />
            <Button android:id="@+id/btn2" android:text="@string/btn_2" />
            <Button android:id="@+id/btn3" android:text="@string/btn_3" />
            <Button android:id="@+id/btnRestar" android:text="@string/btn_restar" />
        </TableRow>

        <!-- Fila 4: CE, 0, ., + -->
        <TableRow android:layout_marginVertical="4dp">
            <Button android:id="@+id/btnReiniciar" android:text="@string/btn_ce" />
            <Button android:id="@+id/btn0" android:text="@string/btn_0" />
            <Button android:id="@+id/btnComa" android:text="@string/btn_coma" />
            <Button android:id="@+id/btnSumar" android:text="@string/btn_sumar" />
        </TableRow>

        <!-- Fila 5: Botón Igual ocupando toda la fila -->
        <TableRow android:layout_marginVertical="4dp">
            <Button
                android:id="@+id/btnIgual"
                android:layout_span="4"
                android:text="@string/btn_igual" />
        </TableRow>

    </TableLayout>

</LinearLayout>