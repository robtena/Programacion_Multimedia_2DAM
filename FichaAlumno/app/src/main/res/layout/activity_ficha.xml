<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainFicha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".FichaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado superior -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0F2F1"
            android:padding="16dp"
            android:text="@string/titulo_ficha_header"
            android:textColor="#004D40"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ScrollView para scroll en pantallas pequeñas -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <!-- Contenedor vertical con margen interno de 24dp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Subtítulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/subtitulo_recibido"
                    android:textColor="#49454F"
                    android:textSize="16sp" />

                <!-- Texto Nombre (ID: txtNombre) -->
                <TextView
                    android:id="@+id/txtNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="#1D1B20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Nombre: Ana" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0" />

                <!-- Texto Edad (ID: txtEdad) -->
                <TextView
                    android:id="@+id/txtEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#1D1B20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Edad: 20" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0" />

                <!-- Texto Curso (ID: txtCurso) -->
                <TextView
                    android:id="@+id/txtCurso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#1D1B20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Curso: 2DAM" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0" />

                <!-- Texto Repetidor (ID: txtRepetidor) -->
                <TextView
                    android:id="@+id/txtRepetidor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#1D1B20"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Repetidor: No" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0" />

                <!-- Botón Volver (ID: btnVolver) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVolver"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#009688"
                    android:text="@string/btn_volver"
                    android:textSize="16sp"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>